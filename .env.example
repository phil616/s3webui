# Copy to .env; use a URL-safe database password, or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
# Native Go execution also requires:
# DATABASE_URL=postgres://s3webui:password@localhost:5432/s3webui?sslmode=disable
# SOURCE_URL=https://your-fork.example/releases/exact-version-source.tar.gz
# Container builds automatically serve bundled corresponding source at /source.
